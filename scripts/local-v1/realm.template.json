{
  "realm": "itsaplan-local",
  "enabled": true,
  "registrationAllowed": false,
  "sslRequired": "none",
  "accessTokenLifespan": 60,
  "groups": [
    {
      "name": "access",
      "subGroups": [
        {
          "name": "frnd-prd",
          "subGroups": [
            {
              "name": "admin"
            },
            {
              "name": "member"
            }
          ]
        }
      ]
    },
    {
      "name": "unrelated"
    }
  ],
  "clients": [
    {
      "clientId": "itsaplan-web",
      "secret": "${client}",
      "protocol": "openid-connect",
      "publicClient": false,
      "standardFlowEnabled": true,
      "serviceAccountsEnabled": false,
      "directAccessGrantsEnabled": false,
      "redirectUris": ["http://localhost:13000/api/auth/oauth2/callback/oidc"],
      "webOrigins": ["http://localhost:3001"],
      "protocolMappers": [
        {
          "name": "groups",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-group-membership-mapper",
          "config": {
            "claim.name": "groups",
            "full.path": "true",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.token.claim": "true"
          }
        }
      ],
      "attributes": {
        "pkce.code.challenge.method": "S256"
      }
    },
    {
      "clientId": "itsaplan-provisioner",
      "secret": "${provisioner}",
      "protocol": "openid-connect",
      "publicClient": false,
      "standardFlowEnabled": false,
      "serviceAccountsEnabled": true,
      "directAccessGrantsEnabled": false,
      "redirectUris": [],
      "webOrigins": [],
      "protocolMappers": [
        {
          "name": "groups",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-group-membership-mapper",
          "config": {
            "claim.name": "groups",
            "full.path": "true",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.token.claim": "true"
          }
        }
      ]
    },
    {
      "clientId": "shastra-local-browser",
      "publicClient": true,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "redirectUris": ["http://localhost:18082/callback"],
      "protocolMappers": [
        {
          "name": "groups",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-group-membership-mapper",
          "config": {
            "claim.name": "groups",
            "full.path": "true",
            "access.token.claim": "true"
          }
        },
        {
          "name": "audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.custom.audience": "http://localhost:18081/mcp",
            "access.token.claim": "true"
          }
        }
      ],
      "webOrigins": ["http://localhost:18082"],
      "attributes": {
        "pkce.code.challenge.method": "S256"
      }
    }
  ],
  "users": [
    {
      "username": "admin",
      "email": "admin@frnd.app",
      "emailVerified": true,
      "enabled": true,
      "firstName": "Admin",
      "lastName": "Local",
      "groups": ["/access/frnd-prd/admin"],
      "credentials": [
        {
          "type": "password",
          "value": "${admin}",
          "temporary": false
        }
      ]
    },
    {
      "username": "member",
      "email": "member@frnd.app",
      "emailVerified": true,
      "enabled": true,
      "firstName": "Member",
      "lastName": "Local",
      "groups": ["/access/frnd-prd/member"],
      "credentials": [
        {
          "type": "password",
          "value": "${member}",
          "temporary": false
        }
      ]
    },
    {
      "username": "newmember",
      "email": "newmember@frnd.app",
      "emailVerified": true,
      "enabled": true,
      "firstName": "Newmember",
      "lastName": "Local",
      "groups": ["/access/frnd-prd/member"],
      "credentials": [
        {
          "type": "password",
          "value": "${newmember}",
          "temporary": false
        }
      ]
    },
    {
      "username": "denied",
      "email": "denied@frnd.app",
      "emailVerified": true,
      "enabled": true,
      "firstName": "Denied",
      "lastName": "Local",
      "groups": [],
      "credentials": [
        {
          "type": "password",
          "value": "${denied}",
          "temporary": false
        }
      ]
    },
    {
      "username": "external",
      "email": "external@outside.test",
      "emailVerified": true,
      "enabled": true,
      "firstName": "External",
      "lastName": "Local",
      "groups": ["/access/frnd-prd/member"],
      "credentials": [
        {
          "type": "password",
          "value": "${external}",
          "temporary": false
        }
      ]
    },
    {
      "username": "service-account-itsaplan-provisioner",
      "serviceAccountClientId": "itsaplan-provisioner",
      "enabled": true,
      "clientRoles": {
        "realm-management": ["query-users", "query-groups"]
      }
    }
  ]
}
